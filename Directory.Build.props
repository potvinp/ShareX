<Project>
  <PropertyGroup>
    <Company>ShareX Team</Company>
    <Product>ShareX</Product>
    <Copyright>Copyright (c) 2007-2026 ShareX Team</Copyright>
    <Version>21.0.0</Version>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Configurations>Release;Debug;Steam;MicrosoftStore;MicrosoftStoreDebug</Configurations>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <!-- Target OS: "windows" (default) or "macos". Pass -p:SharexTargetOS=macos, or a -r osx-* runtime identifier. -->
  <PropertyGroup>
    <SharexTargetOS Condition="'$(SharexTargetOS)' == '' and $(RuntimeIdentifier.StartsWith('osx'))">macos</SharexTargetOS>
    <SharexTargetOS Condition="'$(SharexTargetOS)' == ''">windows</SharexTargetOS>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SharexTargetOS)' == 'windows'">
    <SharexTargetFramework>net10.0-windows</SharexTargetFramework>
    <SharexWindowsSdkTargetFramework>net10.0-windows10.0.22621.0</SharexWindowsSdkTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SharexTargetOS)' == 'macos'">
    <SharexTargetFramework>net10.0</SharexTargetFramework>
    <SharexWindowsSdkTargetFramework>net10.0</SharexWindowsSdkTargetFramework>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier Condition="'$(SharexTargetOS)' == 'windows'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(SharexTargetOS)' == 'macos'">osx-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier Condition="'$(SharexTargetOS)' == 'windows'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(SharexTargetOS)' == 'macos'">osx-arm64</RuntimeIdentifier>
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Steam'">
    <DefineConstants>$(DefineConstants);STEAM</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'MicrosoftStore'">
    <DefineConstants>$(DefineConstants);MicrosoftStore</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'MicrosoftStoreDebug'">
    <DefineConstants>$(DefineConstants);DEBUG;MicrosoftStore</DefineConstants>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>